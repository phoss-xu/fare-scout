# 复制为 .env 后填写，重启 python3 -m app.server 生效。
# 收件邮箱也可以在网页「提醒中心」里修改。
FARE_SCOUT_EMAIL_TO=you@example.com
# 以下以 Gmail 发信为例；也可改成其他邮箱服务的 SMTP 配置。
FARE_SMTP_HOST=smtp.gmail.com
FARE_SMTP_PORT=465
FARE_SMTP_SECURITY=ssl
FARE_SMTP_USER=
# Gmail 使用应用专用密码，不是登录密码。不要将此字段发送到聊天中。
FARE_SMTP_PASSWORD=
FARE_SMTP_FROM=
# 从旧的单人版迁移时才填写：已有记录所属账号的登录邮箱。
FARE_OWNER_EMAIL=
# 部署到 HTTPS 环境时设为 1；本地 HTTP 开发保持 0。
FARE_COOKIE_SECURE=0
